# Scout 360 — variáveis de ambiente do kit local
#
# Copie para .env e ajuste o caminho do banco:
#   cp .env.example .env
#
# O banco é SQLite local. Use caminho RELATIVO à raiz do projeto para que o kit
# seja portável entre máquinas (o .env de desenvolvimento desta VM usa caminho
# absoluto — documentado como risco de portabilidade na homologação v0.11.0,
# qa/homolog-v0110/gate12/estado-tecnico.md).
DATABASE_URL=file:./db/custom.db

# --- OPCIONAIS (não necessários para rodar localmente) ---
# Modo de acesso fechado (gera token auto-assinado em db/.scout-token):
# SCOUT_AUTH_REQUIRED=1
# Ou token explícito (chamadas curl/CLI aceitam x-export-token):
# SCOUT_EXPORT_TOKEN=um-segredo-seu
# Serviço auxiliar de resolução (padrão 127.0.0.1:3030):
# RESOLVE_SERVICE_URL=http://127.0.0.1:3030
